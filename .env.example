APP_NAME=WorxEvents
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=worxevents
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production forces Secure regardless of this flag. Local HTTP can set false.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_TABLE=background_jobs
QUEUE_WORK_MAX_TIME=20

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Comma-separated hosts that serve the platform, not an organization.
PLATFORM_DOMAINS=app.worxevents.com

# Workspace addresses are {slug}.{apex} unless config/organizations.php sets hostname.
WORXEVENTS_APEX=worxevents.com

# stripe until Authorize.net is approved. fake is refused outside tests.
PAYMENTS_GATEWAY=stripe

# Leave blank until a Stripe sandbox exists. Do not commit live or test secrets.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Organizer Authorize.net credentials are not stored in this file.
AUTHORIZE_NET_ENV=sandbox

VITE_APP_NAME="${APP_NAME}"
